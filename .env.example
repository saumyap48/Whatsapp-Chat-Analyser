# PostgreSQL Database Connection URL (e.g. Render, Neon, Supabase)
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/whatsapp_analyzer

# Allowed CORS Origins (JSON list, comma-separated, or single origin)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Maximum file upload size in Megabytes
MAX_UPLOAD_SIZE_MB=50
